---
// Nhận các biến cấu hình SEO từ các trang con truyền vào
const { 
  title = "VPP TỊNH - Cung Cấp Văn Phòng Phẩm & Đồ Thờ Cúng", 
  description = "Chuyên cung cấp sỉ lẻ văn phòng phẩm, thiết bị văn phòng và đồ thờ cúng cao cấp.", 
  image = "https://vpptinh.com/static/banner-share.jpg",
  url = "https://vpptinh.com/"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    
    <!-- Meta SEO Động -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Meta Verify -->
    <meta name="facebook-domain-verification" content="famm52c1ej9x2rlxu5y5hxq2tx23f6" />
    <meta name="p:domain_verify" content="d17be7533c035a2be4f0ff4b71feb5e1"/>

    <!-- Thư viện -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script is:inline>
        tailwind.config = { theme: { extend: { colors: { primary: '#ee4d2d', amazon: '#ff9900' } } } }
    </script>
    
    <!-- CSS toàn cục (Giữ nguyên cấu trúc Blog SEO và hiệu ứng) -->
    <style is:global>
        .loader { border-top-color: #ee4d2d; animation: spinner 1.5s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .blog-content h2 { font-size: 1.5rem; font-weight: bold; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #1f2937; }
        .blog-content p { margin-bottom: 1rem; line-height: 1.6; color: #4b5563; }
        .img-square-wrapper { position: relative; width: 100%; padding-top: 100%; background-color: #f9fafb; overflow: hidden; border-bottom: 1px solid #f3f4f6; }
        .img-square-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; padding: 10px; mix-blend-mode: multiply; transition: transform 0.4s ease; }
        .product-card:hover .img-square-wrapper img { transform: scale(1.08); }
        .product-title-clamp { display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8em; line-height: 1.4em; }
        .marquee-container { background-color: #fff2f0; border-bottom: 1px solid #fee2e2; overflow: hidden; white-space: nowrap; position: relative; padding: 6px 0; }
        .marquee-content { display: inline-block; font-size: 13px; font-weight: 600; color: #d32f2f; padding-left: 100%; animation: marquee 25s linear infinite; }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800 flex flex-col min-h-screen">

    <!-- Header / Navbar -->
    <div class="bg-primary text-white text-xs sm:text-sm py-2">
        <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
            <div class="flex items-center gap-2 font-medium">
                <i class="fa-solid fa-truck-fast"></i> 
                <span>Cảm ơn quý khách đã ghé thăm</span>
            </div>
            <div class="font-semibold"><i class="fa-solid fa-phone mr-1"></i> 0931.736.266</div>
        </div>
    </div>

    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 sm:h-20 items-center gap-4">
                <!-- Đã chuẩn hóa link trỏ về trang chủ gốc -->
                <a href="/" class="flex-shrink-0 flex items-center cursor-pointer">
                    <i class="fa-solid fa-book-open text-primary text-2xl sm:text-3xl mr-2"></i>
                    <span class="font-black text-xl sm:text-2xl tracking-tight text-gray-900 hidden sm:block">VPP TỊNH</span>
                </a>
                
                <div class="flex-1 max-w-2xl mx-auto">
                    <div class="relative rounded-full shadow-sm flex border-2 border-primary overflow-hidden bg-white h-10 sm:h-11">
                        <input type="text" placeholder="Tìm bút bi, giấy A4, đồ thờ..." class="block w-full border-none py-2 pl-4 pr-2 focus:outline-none text-sm">
                        <button class="bg-primary text-white px-6 font-bold transition hover:bg-red-600"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="marquee-container">
        <div class="marquee-content">🔥 CHÀO MỪNG ĐẾN VỚI VPP TỊNH - CUNG CẤP SỈ LẺ VĂN PHÒNG PHẨM & ĐỒ THỜ CÚNG ! &nbsp;&nbsp; | &nbsp;&nbsp; 🚛 FREESHIP TOÀN QUỐC</div>
    </div>

    <!-- KHU VỰC NỘI DUNG ĐỘNG (Trang chủ hoặc Trang chi tiết sẽ "chui" vào đây) -->
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 flex-grow w-full">
        <slot /> 
    </div>

    <!-- Footer -->
    <footer class="bg-gray-900 pt-10 pb-6 border-t-4 border-primary mt-auto text-white">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-gray-400 text-sm mb-4">Cung cấp sỉ lẻ văn phòng phẩm, giấy in và đồ đồng thờ cúng tâm linh.</p>
            <p class="text-gray-500 text-xs">&copy; 2026 Bản quyền thuộc về Cửa hàng VPP TỊNH.</p>
        </div>
    </footer>

</body>
</html>