---
const { title = "VPP TỊNH - Cung Cấp Văn Phòng Phẩm & Đồ Thờ Cúng" } = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    
    <meta name="facebook-domain-verification" content="famm52c1ej9x2rlxu5y5hxq2tx23f6" />
    <meta name="p:domain_verify" content="d17be7533c035a2be4f0ff4b71feb5e1"/>

    <!-- Đã thêm is:inline để Astro không can thiệp vào link CDN của Tailwind -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Đã thêm is:inline cho phần cấu hình màu sắc Tailwind -->
    <script is:inline>
        tailwind.config = {
            theme: { extend: { colors: { primary: '#ee4d2d', amazon: '#ff9900', } } }
        }
    </script>
    
    <style>
        .loader { border-top-color: #ee4d2d; animation: spinner 1.5s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .blog-content h2 { font-size: 1.5rem; font-weight: bold; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #1f2937; }
        .blog-content h3 { font-size: 1.25rem; font-weight: bold; margin-top: 1.25rem; margin-bottom: 0.5rem; color: #374151; }
        .blog-content p { margin-bottom: 1rem; line-height: 1.6; color: #4b5563; }
        .blog-content a { color: #ee4d2d; font-weight: 600; text-decoration: underline; transition: color 0.2s;}
        
        .img-square-wrapper { position: relative; width: 100%; padding-top: 100%; background-color: #f9fafb; overflow: hidden; border-bottom: 1px solid #f3f4f6; }
        .img-square-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; padding: 10px; mix-blend-mode: multiply; transition: transform 0.4s ease; }
        .product-card:hover .img-square-wrapper img { transform: scale(1.08); }
        .product-title-clamp { display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8em; line-height: 1.4em; }

        .sticky-sidebar { position: sticky; top: 90px; height: max-content; }
        .marquee-container { background-color: #fff2f0; border-bottom: 1px solid #fee2e2; overflow: hidden; white-space: nowrap; position: relative; padding: 6px 0; }
        .marquee-content { display: inline-block; font-size: 13px; font-weight: 600; color: #d32f2f; padding-left: 100%; animation: marquee 25s linear infinite; }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }

        .fab-container { position: fixed; bottom: 90px; right: 20px; z-index: 999; display: flex; gap: 12px; flex-direction: column; }
        .fab-btn { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.2s; cursor: pointer; border: none; }
        .fab-btn:hover { transform: scale(1.1); }
        .fab-zalo { background-color: #0068ff; }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800 flex flex-col min-h-screen">

    <!-- Top Bar -->
    <div class="bg-primary text-white text-xs sm:text-sm py-2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
            <div class="flex items-center gap-2 font-medium">
                <i class="fa-solid fa-truck-fast"></i> 
                <span class="hidden sm:inline"> Cảm ơn quý khách đã ghé thăm </span>
                <span class="sm:hidden">Chúc quý khách có một trải nghiệm thật thoải mái </span>
            </div>
            <div class="flex items-center gap-4 font-semibold">
                <a href="#" class="hover:text-gray-200 transition"><i class="fa-solid fa-phone mr-1"></i> 0931.736.266</a>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 sm:h-20 items-center gap-2 sm:gap-4">
                <a href="/" class="flex-shrink-0 flex items-center cursor-pointer block">
                    <i class="fa-solid fa-book-open text-primary text-2xl sm:text-3xl mr-1 sm:mr-2"></i>
                    <span class="font-black text-xl sm:text-2xl tracking-tight text-gray-900 hidden sm:block">VPP TỊNH</span>
                </a>
                
                <div class="flex-1 max-w-2xl mx-auto pl-2 sm:pl-0">
                    <div class="relative rounded-full shadow-sm flex border-2 border-primary overflow-hidden bg-white h-10 sm:h-11">
                        <input type="text" class="block w-full border-none py-2 pl-4 pr-2 focus:outline-none text-xs sm:text-sm" placeholder="Tìm bút bi, giấy A4, đồ thờ...">
                        <button class="bg-primary hover:bg-red-600 text-white px-4 sm:px-6 font-bold transition flex items-center justify-center">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center space-x-2 sm:space-x-5 pl-1 sm:pl-2">
                    <div class="flex items-center bg-gray-100 rounded-full p-1 border border-gray-200 mr-1 sm:mr-0">
                        <button class="bg-white text-primary font-bold text-[10px] sm:text-xs px-2 sm:px-3 py-1 rounded-full shadow-sm cursor-default">🇻🇳 VN</button>
                        <a href="/en" class="text-gray-500 hover:text-gray-800 font-medium text-[10px] sm:text-xs px-2 sm:px-3 py-1 rounded-full transition cursor-pointer">🇺🇸 EN</a>
                    </div>
                    <div class="relative cursor-pointer text-gray-600 hover:text-primary transition hidden sm:block">
                        <i class="fa-solid fa-cart-shopping text-2xl"></i>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Marquee -->
    <div class="marquee-container">
        <div class="marquee-content">
            🔥 CHÀO MỪNG ĐẾN VỚI VPP TỊNH - CUNG CẤP VĂN PHÒNG PHẨM & ĐỒ THỜ CÚNG ! &nbsp;&nbsp; | &nbsp;&nbsp; 🚛 FREESHIP TOÀN QUỐC &nbsp;&nbsp; | &nbsp;&nbsp; 🎁 KẾT NỐI TRỰC TIẾP QUA ZALO ĐỂ NHẬN BÁO GIÁ SỈ LÔ LỚN TỐT NHẤT!
        </div>
    </div>

    <!-- KHU VỰC CHÈN NỘI DUNG ĐỘNG TỪ TRANG CHỦ HOẶC TRANG CHI TIẾT -->
    <slot />

    <!-- Nút Zalo Nổi -->
    <div class="fab-container">
        <a href="https://zalo.me/0931736266" target="_blank" class="fab-btn fab-zalo" title="Chat Zalo">
            <i class="fa-solid fa-comment-dots text-2xl"></i>
        </a>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-900 pt-10 sm:pt-14 pb-5 sm:pb-6 border-t-4 border-primary mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div>
                    <div class="flex items-center mb-3 text-white">
                        <i class="fa-solid fa-book-open text-primary text-2xl mr-2"></i>
                        <span class="font-black text-xl tracking-tight">VPP TỊNH</span>
                    </div>
                    <p class="text-gray-400 text-sm leading-relaxed mb-4">Cung cấp văn phòng phẩm, giấy in và đồ đồng thờ cúng tâm linh. Sản phẩm chính hãng, giá cạnh tranh nhất thị trường.</p>
                </div>
                <div>
                    <h4 class="text-white font-bold text-sm mb-3 uppercase tracking-wider">Liên Hệ</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li class="flex items-start gap-2"><i class="fa-solid fa-location-dot mt-1 text-primary"></i> 265/3 Đường Bình Tiên , HCM </li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-phone text-primary"></i> 0931.736.266 (Zalo Sỉ)</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-800 pt-4 text-center">
                <p class="text-gray-500 text-xs">&copy; 2026 Bản quyền thuộc về Cửa hàng VPP TỊNH. 
                <a href="/chinh-sach-bao-mat" class="hover:text-primary underline ml-2 transition">Chính Sách Bảo Mật</a>
                </p>
            </div>
        </div>
    </footer>

</body>
</html>