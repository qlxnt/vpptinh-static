                    <p class="text-gray-500 text-xs">&copy; 2026 VPP TINH. All rights reserved.</p>
                    <a href="privacy" class="text-gray-500 hover:text-gray-300 text-xs underline mt-1 inline-block transition">Privacy Policy & Affiliate Disclosure</a>
                </div>
                <div class="flex gap-2 text-gray-400 text-2xl">
                    <i class="fa-brands fa-amazon"></i>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>