        <p>VPP TINH is a participant in the Amazon Services LLC Associates Program. We earn from qualifying purchases of curated Zen & Buddhist products.</p>
    </div>

    <!-- Marquee EN -->
    <div class="marquee-container">
        <div class="marquee-content">
            ✨ WELCOME TO VPP TINH | HANDPICKED BUDDHIST STATUES, MEDITATION INCENSE & ZEN OFFICE DECOR &nbsp;&nbsp; | &nbsp;&nbsp; 📦 SECURE CHECKOUT VIA AMAZON &nbsp;&nbsp; | &nbsp;&nbsp; 🤝 CONTACT US VIA WHATSAPP FOR DIRECT B2B WHOLESALE EXPORTS FROM VIETNAM!
        </div>
    </div>

    <!-- VÙNG NỘI DUNG ĐỘNG CỦA ASTRO -->
    <slot />

    <!-- FAB WhatsApp -->
    <div class="fab-container">
        <a href="https://wa.me/84931736266" target="_blank" class="fab-btn fab-whatsapp" title="WhatsApp Us (B2B Wholesale)">
            <i class="fa-brands fa-whatsapp"></i>
        </a>
    </div>

    <!-- Footer EN -->
    <footer class="bg-gray-900 pt-10 sm:pt-14 pb-5 sm:pb-6 border-t-4 border-primary mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 mb-8">
                <div>
