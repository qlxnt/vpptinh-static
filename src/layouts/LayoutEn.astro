                <a href="/en" class="flex-shrink-0 flex items-center cursor-pointer block">
                    <i class="fa-solid fa-yin-yang text-primary text-2xl sm:text-3xl mr-1 sm:mr-2"></i>
                    <span class="font-black text-xl sm:text-2xl tracking-tight text-gray-900 hidden sm:block">VPP TINH</span>
                </a>
                
