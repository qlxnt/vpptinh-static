---
const { title = "VPP TINH - Premium Buddhist Supplies & Zen Office Decor" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="p:domain_verify" content="d17be7533c035a2be4f0ff4b71feb5e1"/>

    <!-- Đã thêm is:inline -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Đã thêm is:inline và mã màu đặc trưng cho bản tiếng Anh -->
    <script is:inline>
        tailwind.config = {
            theme: { extend: { colors: { primary: '#ee4d2d', amazon: '#f90', zen: '#4a5568' } } }
        }
    </script>
    
    <style>
        .loader { border-top-color: #ee4d2d; animation: spinner 1.5s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .blog-content h2 { font-size: 1.5rem; font-weight: bold; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #2d3748; }
        .blog-content h3 { font-size: 1.25rem; font-weight: bold; margin-top: 1.25rem; margin-bottom: 0.5rem; color: #4a5568; }
        .blog-content p { margin-bottom: 1rem; line-height: 1.7; color: #4b5563; }
        .blog-content a { color: #ee4d2d; font-weight: 600; text-decoration: underline; transition: color 0.2s;}
        
        .img-square-wrapper { position: relative; width: 100%; padding-top: 100%; background-color: #f9fafb; overflow: hidden; border-bottom: 1px solid #f3f4f6; }
        .img-square-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; padding: 10px; mix-blend-mode: multiply; transition: transform 0.4s ease; }
        .product-card:hover .img-square-wrapper img { transform: scale(1.08); }
        .product-title-clamp { display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8em; line-height: 1.4em; }

        .sticky-sidebar { position: sticky; top: 90px; height: max-content; }
        .marquee-container { background-color: #fff2f0; border-bottom: 1px solid #fee2e2; overflow: hidden; white-space: nowrap; position: relative; padding: 8px 0; }
        .marquee-content { display: inline-block; font-size: 13px; font-weight: 600; color: #d32f2f; padding-left: 100%; animation: marquee 28s linear infinite; }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }

        .fab-container { position: fixed; bottom: 20px; right: 20px; z-index: 999; display: flex; gap: 12px; flex-direction: column; }
        .fab-btn { width: 55px; height: 55px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 28px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.2s; cursor: pointer; border: none; }
        .fab-btn:hover { transform: scale(1.1); }
        .fab-whatsapp { background-color: #25D366; }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800 flex flex-col min-h-screen">

    <!-- Top Bar EN -->
    <div class="bg-primary text-white text-xs sm:text-sm py-2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
            <div class="flex items-center gap-2 font-medium">
                <i class="fa-solid fa-leaf"></i> 
                <span class="hidden sm:inline">Cultivate peace in your workspace & home</span>
                <span class="sm:hidden">Zen Workspace Essentials</span>
            </div>
            <div class="flex items-center gap-4 font-semibold">
                <a href="https://wa.me/84931736266" target="_blank" class="hover:text-gray-200 transition"><i class="fa-brands fa-whatsapp mr-1"></i> B2B Wholesale Contact</a>
            </div>
        </div>
    </div>

    <!-- Navbar EN -->
