                        <input type="text" class="block w-full border-none py-2 pl-4 pr-2 focus:outline-none text-xs sm:text-sm" placeholder="Search Buddha statues, incense, zen decor...">
                        <button class="bg-primary hover:bg-red-600 text-white px-4 sm:px-6 font-bold transition flex items-center justify-center">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center space-x-2 sm:space-x-5 pl-1 sm:pl-2">
                    <div class="flex items-center bg-gray-100 rounded-full p-1 border border-gray-200 mr-1 sm:mr-0">
                        <a href="/" class="text-gray-500 hover:text-gray-800 font-medium text-[10px] sm:text-xs px-2 sm:px-3 py-1 rounded-full transition cursor-pointer">🇻🇳 VN</a>
