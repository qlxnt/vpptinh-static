---
// KHU VỰC 1: XỬ LÝ SERVER-SIDE
import LayoutEn from '../layouts/LayoutEn.astro';
import SidebarZenBlog from '../components/SidebarZenBlog.astro'; // Đã import Component Sidebar tiếng Anh
import { supabase } from '../lib/supabase.js';

// Lấy dữ liệu: Dùng lệnh .ilike để lọc các sản phẩm có platform chứa chữ "Amazon"
const { data: products, error } = await supabase
    .from('vpp_catalog')
    .select('name, slug, price, images, platform, category')
    .ilike('platform', '%Amazon%')
    .order('created_at', { ascending: false })
    .limit(200);

// Nhóm sản phẩm theo danh mục
const groupedProducts = {};

if (products) {
    products.forEach(p => {
        const rawCat = p.category;
        const mainCat = rawCat ? rawCat.trim() : 'Featured Products';
        
        if (!groupedProducts[mainCat]) {
            groupedProducts[mainCat] = [];
        }
        
        // Xử lý giá tiền USD (chia cho 100)
        let finalPrice = p.price || 0;
        const priceFormatted = `$${(finalPrice / 100).toFixed(2)}`;
        
        const imgUrl = (p.images && p.images.length > 0) ? p.images[0] : 'https://via.placeholder.com/300';

        groupedProducts[mainCat].push({
            ...p,
            priceFormatted,
            imgUrl
        });
    });
}
---

<!-- KHU VỰC 2: RENDER GIAO DIỆN -->
<LayoutEn title="VPP TINH - Premium Buddhist Supplies & Zen Office Decor">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 flex-grow w-full flex flex-col lg:flex-row gap-5 sm:gap-8">
        
        <!-- Khối Sản Phẩm Quốc Tế -->
        <main class="w-full lg:w-3/4">
            {Object.keys(groupedProducts).length === 0 ? (
                <div class="text-center bg-white rounded-xl shadow-sm p-8 border border-gray-100">
                    <h2 class="text-xl font-bold text-gray-700">No products found for this region.</h2>
                </div>
            ) : (
                Object.entries(groupedProducts).map(([category, items]) => (
                    <div class="mb-5 bg-white rounded-xl shadow-sm p-3 sm:p-4 border border-gray-100">
                        <div class="flex justify-between items-end mb-3 border-b-2 border-primary pb-2">
                            <h3 class="text-sm sm:text-lg font-bold text-gray-800 uppercase tracking-wide flex items-center">
                                <i class="fa-solid fa-layer-group text-primary mr-2 text-base sm:text-lg"></i> {category.toUpperCase()}
                            </h3>
                        </div>
                        
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4">
                            {/* Chú ý: Đường dẫn URL giờ sẽ có thêm tiền tố để phân biệt */}
                            {items.slice(0, 8).map((p) => (
                                <a href={`${p.slug}`} class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary hover:shadow-md transition-all duration-300 cursor-pointer product-card flex flex-col h-full block">
                                    <div class="img-square-wrapper">
                                        <img src={p.imgUrl} loading="lazy" alt={p.name} />
                                    </div>
                                    <div class="p-2 sm:p-3 flex flex-col flex-grow">
                                        <h4 class="text-xs sm:text-sm text-gray-800 font-medium product-title-clamp mb-1.5">{p.name}</h4>
                                        <div class="mt-auto flex items-center justify-between pt-1.5 border-t border-gray-50">
                                            <span class="text-primary font-bold text-sm sm:text-base">{p.priceFormatted}</span>
                                            <div class="bg-amazon text-white text-[9px] px-1.5 py-0.5 rounded font-bold">AMAZON</div>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                        
                        <!-- Cập nhật liên kết View All -->
                        <div class="mt-3 text-right">
                            <a href={`category/${category.toLowerCase().replace(/ /g, '-')}`} class="text-primary text-[12px] font-bold hover:text-red-700 transition-colors">
                                View all ({items.length} products) <i class="fa-solid fa-angle-right ml-0.5"></i>
                            </a>
                        </div>
                    </div>
                ))
            )}
        </main>

        <!-- Khối Sidebar SEO -->
        <aside class="w-full lg:w-1/4 mt-2 lg:mt-0">
            <SidebarZenBlog />
        </aside>

    </div>
</LayoutEn>