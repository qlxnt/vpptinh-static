    <script>
        const SUPABASE_URL = 'https://nwjttlsrogmgjqwuyokb.supabase.co'; 
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im53anR0bHNyb2dtZ2pxd3V5b2tiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NDU3OTc0NiwiZXhwIjoyMDkwMTU1NzQ2fQ.juiQrHJWAnC90bU6Ip96fS8Qd6PaGDQnzv9vdj-UnlI'; 
        
        const appContainer = document.getElementById('app-container');
        const sidebarContainer = document.getElementById('sidebar-container');
        let supabaseClient = null;

        try {
            supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        } catch (err) {
            appContainer.innerHTML = `<div class="text-center text-red-500 bg-red-50 p-6 rounded-lg mt-10"><b>Lỗi khởi tạo:</b> ${err.message}</div>`;
        }

        function cleanHTML(htmlString) {
            if (!htmlString) return '';
            const txt = document.createElement("textarea");
            txt.innerHTML = htmlString;
            return txt.value.replace(/```html/g, '').replace(/```/g, '').trim();
        }

        function getMainCategory(rawCat) {
            if (!rawCat) return 'Sản Phẩm Khác';
            return rawCat.trim(); 
        }

        window.expandSeoContent = () => document.getElementById('seoWrapper').classList.add('expanded');
       
        window.handleCategorySelect = function(value) {
            if (value) { goCategory(value); } 
            else { goHome(); }
        };

        async function loadSeoSidebar() {
            if (!supabaseClient) return;
            const sidebarList = document.getElementById('seo-sidebar-list');
            try {
                const { data, error } = await supabaseClient
                    .from('vpp_catalog')
                    .select('slug, seo_title, name, images')
                    .in('platform', ['Shopee', 'Shopee VN', 'Lazada'])
                    .not('seo_title', 'is', null)
                    .order('created_at', { ascending: false })
                    .limit(5);
                    
                if (error || !data.length) { sidebarList.innerHTML = `<div class="text-sm text-gray-500 text-center py-2">Chưa có bài viết.</div>`; return; }
                let html = '';
                data.forEach(item => {
                    const title = item.seo_title || item.name;
                    let imgUrl = item.images?.[0] || 'https://via.placeholder.com/150';
                    html += `
                        <div class="flex gap-2 sm:gap-3 items-center cursor-pointer group hover:bg-gray-50 p-2 -mx-2 rounded-lg transition-colors" onclick="goDetail('${item.slug}')">
                            <div class="w-12 h-12 sm:w-14 sm:h-14 flex-shrink-0 rounded-lg overflow-hidden border border-gray-100 bg-white p-1">
                                <img src="${imgUrl}" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-110 transition-transform" loading="lazy">
                            </div>
                            <h4 class="text-xs sm:text-sm font-semibold text-gray-700 line-clamp-3 group-hover:text-primary">${title}</h4>
                        </div>`;
                });
                sidebarList.innerHTML = html;
            } catch (err) { sidebarList.innerHTML = `<div class="text-xs text-red-500">Lỗi tải dữ liệu</div>`; }
        }

        async function handleRoute() {
            if (!supabaseClient) return;
            const urlParams = new URLSearchParams(window.location.search);
            const slug = urlParams.get('slug');
            const cat = urlParams.get('cat');
            const page = urlParams.get('page');
            
            sidebarContainer.style.display = page ? 'none' : 'block';
            
            if (slug) await renderDetailView(slug);
            else if (cat) await renderCategoryView(cat);
            else if (page) await renderPageView(page);
            else await renderHomeView();
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Đã cập nhật hàm goHome() để đẩy url về trang gốc sạch sẽ
        function goHome() { window.history.pushState({}, '', '/'); handleRoute(); }
        function goDetail(slug) { window.history.pushState({}, '', `?slug=${slug}`); handleRoute(); }
        function goCategory(cat) { window.history.pushState({}, '', `?cat=${encodeURIComponent(cat)}`); handleRoute(); }
        function goPage(pageId) { window.history.pushState({}, '', `?page=${pageId}`); handleRoute(); }
        window.addEventListener('popstate', handleRoute);

        async function renderHomeView() {
            document.title = "VPP TỊNH - Cung Cấp Văn Phòng Phẩm";
            appContainer.innerHTML = `<div class="flex justify-center items-center h-64"><div class="loader ease-linear rounded-full border-4 border-t-4 border-gray-200 h-12 w-12"></div></div>`;

            try {
                const { data: products, error } = await supabaseClient
                    .from('vpp_catalog')
                    .select('name, slug, price, images, platform, category')
                    .in('platform', ['Shopee', 'Shopee VN', 'Lazada'])
                    .order('created_at', { ascending: false })
                    .limit(200);
                    
                if (error) throw error;
                if (!products || !products.length) {
                    appContainer.innerHTML = `<div class="text-center bg-white rounded-xl shadow-sm p-8 border border-gray-100"><h2 class="text-xl font-bold text-gray-700">Chưa có sản phẩm nào</h2></div>`;
                    return;
                }

                const groupedProducts = {};
                products.forEach(p => {
                    const mainCat = getMainCategory(p.category);
                    if (!groupedProducts[mainCat]) groupedProducts[mainCat] = [];
                    groupedProducts[mainCat].push(p);
                });

                let html = ``;
                for (const [category, items] of Object.entries(groupedProducts)) {
                    html += `
                    <div class="mb-5 bg-white rounded-xl shadow-sm p-3 sm:p-4 border border-gray-100">
                        <div class="flex justify-between items-end mb-3 border-b-2 border-primary pb-2">
                            <h3 class="text-sm sm:text-lg font-bold text-gray-800 uppercase tracking-wide flex items-center">
                                <i class="fa-solid fa-layer-group text-primary mr-2 text-base sm:text-lg"></i> ${category.toUpperCase()}
                            </h3>
                        </div>
                        
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4">`;

                    const displayItems = items.slice(0, 8); 
                    
                    displayItems.forEach((p) => {
                        let imgUrl = p.images?.[0] || 'https://via.placeholder.com/300';
                        const isAmazon = p.platform?.includes('Amazon');
                        
                        let finalPrice = p.price || 0;
                        if (!isAmazon && finalPrice > 0 && finalPrice < 1000) {
                            finalPrice = finalPrice * 1000;
                        }
                        const priceFormatted = isAmazon ? `$${(finalPrice / 100).toFixed(2)}` : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(finalPrice);

                        html += `
                            <div class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary hover:shadow-md transition-all duration-300 cursor-pointer product-card flex flex-col h-full" onclick="goDetail('${p.slug}')">
                                <div class="img-square-wrapper"><img src="${imgUrl}" loading="lazy"></div>
                                <div class="p-2 sm:p-3 flex flex-col flex-grow">
                                    <h4 class="text-xs sm:text-sm text-gray-800 font-medium product-title-clamp mb-1.5">${p.name}</h4>
                                    <div class="mt-auto flex items-center justify-between pt-1.5 border-t border-gray-50">
                                        <span class="text-primary font-bold text-sm sm:text-base">${priceFormatted}</span>
                                        <div class="bg-red-50 text-red-500 text-[9px] px-1 rounded font-bold border border-red-100">MỚI</div>
                                    </div>
                                </div>
                            </div>`;
                    });
                    
                    html += `</div>
                        <div class="mt-3 text-right">
                            <a href="#" onclick="event.preventDefault(); goCategory('${category}')" class="text-primary text-[12px] font-bold hover:text-red-700 transition-colors">
                                Xem tất cả (${items.length} sản phẩm) <i class="fa-solid fa-angle-right ml-0.5"></i>
                            </a>
                        </div>
                    </div>`;
                }
                appContainer.innerHTML = html;
            } catch (error) { appContainer.innerHTML = `<div class="text-center text-red-500 bg-red-50 p-4 rounded-lg"><b>Lỗi:</b> ${error.message}</div>`; }
        }

        async function renderCategoryView(catName) {
            document.title = `${catName.toUpperCase()} | VPP TỊNH`;
            appContainer.innerHTML = `<div class="flex justify-center items-center h-64"><div class="loader"></div></div>`;
            try {
                const { data: products } = await supabaseClient
                    .from('vpp_catalog')
                    .select('name, slug, price, images, platform, category')
                    .in('platform', ['Shopee', 'Shopee VN', 'Lazada'])
                    .order('created_at', { ascending: false })
                    .limit(200);
                    
                const items = products.filter(p => getMainCategory(p.category) === catName);
                
                let html = `
                    <button onclick="goHome()" class="mb-3 flex items-center text-gray-500 hover:text-primary transition font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-arrow-left mr-1.5"></i> Quay lại
                    </button>
                    <div class="bg-white rounded-xl shadow-sm p-3 sm:p-5 border border-gray-100">
                        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-4 pb-2 border-b-2 border-primary uppercase">${catName}</h2>
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4">`;
                        
                items.forEach((p) => {
                    let imgUrl = p.images?.[0] || 'https://via.placeholder.com/300';
                    const isAmazon = p.platform?.includes('Amazon');
                    
                    let finalPrice = p.price || 0;
                    if (!isAmazon && finalPrice > 0 && finalPrice < 1000) { finalPrice = finalPrice * 1000; }
                    const priceFormatted = isAmazon ? `$${(finalPrice / 100).toFixed(2)}` : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(finalPrice);
                    
                    html += `
                        <div class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary hover:shadow-md cursor-pointer product-card flex flex-col h-full" onclick="goDetail('${p.slug}')">
                            <div class="img-square-wrapper"><img src="${imgUrl}" loading="lazy"></div>
                            <div class="p-2 sm:p-3 flex flex-col flex-grow">
                                <h4 class="text-xs sm:text-sm text-gray-800 font-medium product-title-clamp mb-1.5">${p.name}</h4>
                                <div class="mt-auto pt-1.5 border-t border-gray-50"><span class="text-primary font-bold text-sm sm:text-base">${priceFormatted}</span></div>
                            </div>
                        </div>`;
                });
                html += `</div></div>`;
                appContainer.innerHTML = html;
            } catch (err) { goHome(); }
        }

        async function renderDetailView(slug) {
            appContainer.innerHTML = `<div class="flex justify-center items-center h-64"><div class="loader ease-linear rounded-full border-4 border-t-4 border-gray-200 h-12 w-12"></div></div>`;

            try {
                const { data: p, error } = await supabaseClient.from('vpp_catalog').select('*').eq('slug', slug).single();
                if (error || !p) throw new Error("Không tìm thấy sản phẩm");

                document.title = (p.seo_title || p.name) + " | VPP TỊNH";

                const isAmazon = p.platform?.includes('Amazon');
                
                let finalPrice = p.price || 0;
                if (!isAmazon && finalPrice > 0 && finalPrice < 1000) {
                    finalPrice = finalPrice * 1000;
                }
                const priceFormatted = isAmazon ? `$${(finalPrice / 100).toFixed(2)}` : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(finalPrice);
                
                const mainImg = p.images?.[0] || 'https://via.placeholder.com/500';
                const cleanDescription = cleanHTML(p.description);
                const cleanSeoContent = cleanHTML(p.seo_content);
                const platformDisplay = p.platform === 'Shopee VN' ? 'Shopee' : (p.platform || 'Sàn TMĐT');

                let relatedProductsHtml = '';
                const mainCategoryCurrent = getMainCategory(p.category);
                
                const { data: allRelated } = await supabaseClient
                    .from('vpp_catalog')
                    .select('name, slug, price, images, platform, category')
                    .in('platform', ['Shopee', 'Shopee VN', 'Lazada'])
                    .neq('slug', slug)
                    .order('created_at', { ascending: false })
                    .limit(50); 
                
                if (allRelated) {
                    const filteredRelated = allRelated.filter(rp => getMainCategory(rp.category) === mainCategoryCurrent).slice(0, 4);
                    if (filteredRelated.length > 0) {
                        relatedProductsHtml = `<div class="mt-4 sm:mt-6 bg-white rounded-xl shadow-sm border border-gray-100 p-3 sm:p-5"><h3 class="text-base sm:text-lg font-bold text-gray-900 mb-3 border-l-4 border-primary pl-2.5">Sản phẩm cùng danh mục</h3><div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4">`;
                        filteredRelated.forEach(rp => {
                            let rImgUrl = rp.images?.[0] || 'https://via.placeholder.com/300';
                            const rIsAmazon = rp.platform?.includes('Amazon');
                            let rFinalPrice = rp.price || 0;
                            if (!rIsAmazon && rFinalPrice > 0 && rFinalPrice < 1000) { rFinalPrice = rFinalPrice * 1000; }
                            const rPrice = rIsAmazon ? `$${(rFinalPrice / 100).toFixed(2)}` : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(rFinalPrice);
                            
                            relatedProductsHtml += `
                                <div class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary transition-colors cursor-pointer product-card flex flex-col h-full" onclick="goDetail('${rp.slug}')">
                                    <div class="img-square-wrapper"><img src="${rImgUrl}" loading="lazy"></div>
                                    <div class="p-2 sm:p-3 flex flex-col flex-grow">
                                        <h4 class="text-xs sm:text-sm font-medium text-gray-800 product-title-clamp">${rp.name}</h4>
                                        <div class="mt-auto pt-1.5 text-primary font-bold text-sm">${rPrice}</div>
                                    </div>
                                </div>`;
                        });
                        relatedProductsHtml += `</div></div>`;
                    }
                }

                let seoBlockHtml = '';
                if (cleanSeoContent) {
                    seoBlockHtml = `
                        <div class="mt-4 sm:mt-6 bg-white rounded-xl shadow-sm border border-gray-100 p-4 sm:p-6">
                            <h2 class="text-base sm:text-xl font-bold text-gray-900 mb-3 pb-2 border-b border-gray-100">Đánh giá chi tiết sản phẩm</h2>
                            <div class="seo-content-wrapper" id="seoWrapper">
                                <div class="blog-content max-w-none text-[13px] sm:text-sm">${cleanSeoContent}</div>
                                <div class="seo-overlay">
                                    <button onclick="expandSeoContent()" class="bg-gray-800 text-white px-4 py-1.5 rounded-full font-semibold hover:bg-gray-700 shadow-md transition text-xs sm:text-sm">
                                        Đọc thêm chi tiết <i class="fa-solid fa-chevron-down ml-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>`;
                }

                appContainer.innerHTML = `
                    <button onclick="goHome()" class="mb-3 flex items-center text-gray-500 hover:text-primary transition font-medium text-xs sm:text-sm">
                        <i class="fa-solid fa-arrow-left mr-1.5"></i> Quay lại
                    </button>
                    
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                            <div class="p-3 sm:p-6 bg-gray-50 flex items-center justify-center border-b md:border-b-0 md:border-r border-gray-100">
                                <img src="${mainImg}" alt="${p.name}" class="max-w-full max-h-[250px] sm:max-h-[350px] object-contain mix-blend-multiply">
                            </div>
                            
                            <div class="p-4 sm:p-6 flex flex-col justify-center">
                                <span class="text-[9px] sm:text-[10px] font-bold tracking-widest text-gray-400 uppercase mb-1.5">${p.category || 'Danh mục'}</span>
                                <h1 class="text-base sm:text-xl font-bold text-gray-900 leading-snug mb-2">${p.name}</h1>
                                <div class="text-xl sm:text-2xl font-extrabold text-primary mb-3">${priceFormatted}</div>
                                
                                <div class="bg-red-50 text-red-700 text-xs p-2.5 rounded-lg mb-4 border border-red-100">
                                    <i class="fa-solid fa-truck-fast mr-1"></i> Trợ giá vận chuyển khi mua qua đối tác.
                                </div>
                                
                                <div class="prose prose-sm text-gray-600 mb-5 blog-content line-clamp-4 text-xs sm:text-sm">${cleanDescription}</div>
                                
                                <div class="flex gap-2 mt-auto">
                                    <a href="${p.affiliate_link}" target="_blank" rel="nofollow" class="w-full bg-primary hover:bg-red-600 text-white font-bold text-xs sm:text-sm py-2.5 sm:py-3 rounded-lg shadow-sm transition flex items-center justify-center">
                                        <i class="fa-solid fa-cart-shopping mr-1.5"></i> Mua trên ${platformDisplay}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    ${seoBlockHtml}
                    ${relatedProductsHtml}
                `;

            } catch (error) { appContainer.innerHTML = `<div class="text-center py-10"><h2 class="text-lg sm:text-xl font-bold text-gray-700 mb-3">Opps! Sản phẩm bị lỗi hoặc không tồn tại.</h2><button onclick="goHome()" class="px-5 py-1.5 text-sm bg-primary text-white rounded-full font-bold">Quay lại trang chủ</button></div>`; }
        }

        async function renderPageView(pageId) {
            let title = "";
            let content = "";

            switch(pageId) {
                case 'chinh-sach-van-chuyen':
                    title = "Chính sách vận chuyển";
                    content = `
                        <h3>1. Thời gian giao hàng</h3>
                        <p>VPP TỊNH cam kết giao hàng đúng thời gian.</p>
                    `;
                    break;
                case 'chinh-sach-doi-tra':
                    title = "Chính sách đổi trả";
                    content = `
                        <h3>1. Điều kiện đổi trả</h3>
                        <p>Khách hàng được quyền đổi trả sản phẩm trong vòng <b>7 ngày</b> kể từ ngày nhận hàng nếu thỏa mãn các điều kiện: Sản phẩm bị lỗi do nhà sản xuất, Giao sai mẫu mã/số lượng, Sản phẩm hư hỏng trong quá trình vận chuyển.</p>
                    `;
                    break;
                case 'huong-dan-mua-si':
                    title = "Hướng dẫn mua sỉ & Đại lý";
                    content = `
                        <h3>Kết nối trực tiếp xưởng sản xuất</h3>
                        <p>VPP TỊNH tự hào là tổng kho phân phối không qua trung gian. Chúng tôi cung cấp chính sách chiết khấu cực kỳ hấp dẫn (lên đến 40%) cho khách hàng mua số lượng lớn.</p>
                    `;
                    break;
                default:
                    title = "Chính sách bảo mật";
                    content = `<p>VPP TỊNH cam kết bảo vệ tuyệt đối thông tin cá nhân của khách hàng. Chúng tôi không chia sẻ thông tin của bạn cho bất kỳ bên thứ 3 nào khác.</p>`;
            }

            document.title = `${title} | VPP TỊNH`;
            appContainer.innerHTML = `
                <button onclick="goHome()" class="mb-3 flex items-center text-gray-500 hover:text-primary transition font-medium text-xs sm:text-sm">
                    <i class="fa-solid fa-arrow-left mr-1.5"></i> Quay lại trang chủ
                </button>
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 sm:p-8 max-w-4xl mx-auto">
                    <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mb-5 pb-3 border-b-2 border-primary">${title}</h1>
                    <div class="blog-content text-sm sm:text-base text-gray-700">${content}</div>
                </div>
            `;
        }

        window.onload = () => {
            handleRoute();
            loadSeoSidebar();
        };
    </script>

</body>
</html>