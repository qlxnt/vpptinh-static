---
// Nhúng bộ khung giao diện và bộ kết nối cơ sở dữ liệu vào
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase.js';

// 1. GỌI DỮ LIỆU TỪ SUPABASE NGAY LÚC BIÊN DỊCH (Trang sẽ load với tốc độ bàn thờ)
const { data: products, error } = await supabase
    .from('vpp_catalog')
    .select('name, slug, price, images, platform, category')
    .in('platform', ['Shopee', 'Shopee VN', 'Lazada'])
    .order('created_at', { ascending: false })
    .limit(200);

if (error) {
    console.error("Lỗi lấy dữ liệu trang chủ:", error.message);
}

// 2. HÀM PHÂN NHÓM SẢN PHẨM (Xử lý ngay trên Server)
function getMainCategory(rawCat) {
    if (!rawCat) return 'Sản Phẩm Khác';
    return rawCat.trim();
}

const groupedProducts = {};
if (products) {
    products.forEach(p => {
        const mainCat = getMainCategory(p.category);
        if (!groupedProducts[mainCat]) groupedProducts[mainCat] = [];
        groupedProducts[mainCat].push(p);
    });
}
---

<MainLayout>
    <!-- Khung chia cột: 3/4 cho sản phẩm, 1/4 cho Sidebar -->
    <div class="flex flex-col lg:flex-row gap-5 sm:gap-8">
        
        <main class="w-full lg:w-3/4">
            <!-- Nếu không có sản phẩm -->
            {Object.keys(groupedProducts).length === 0 && (
                <div class="text-center bg-white rounded-xl shadow-sm p-8 border border-gray-100">
                    <h2 class="text-xl font-bold text-gray-700">Chưa có sản phẩm nào</h2>
                </div>
            )}

            <!-- Lặp qua từng danh mục để in ra khối sản phẩm -->
            {Object.entries(groupedProducts).map(([category, items]) => (
                <div class="mb-5 bg-white rounded-xl shadow-sm p-3 sm:p-4 border border-gray-100">
                    
                    <div class="flex justify-between items-end mb-3 border-b-2 border-primary pb-2">
                        <h3 class="text-sm sm:text-lg font-bold text-gray-800 uppercase tracking-wide flex items-center">
                            <i class="fa-solid fa-layer-group text-primary mr-2 text-base sm:text-lg"></i> {category}
                        </h3>
                    </div>
                    
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4">
                        {items.slice(0, 8).map((p) => {
                            // Xử lý giá cả và hình ảnh
                            let imgUrl = p.images?.[0] || 'https://via.placeholder.com/300';
                            const isAmazon = p.platform?.includes('Amazon');
                            
                            let finalPrice = p.price || 0;
                            if (!isAmazon && finalPrice > 0 && finalPrice < 1000) {
                                finalPrice = finalPrice * 1000;
                            }
                            const priceFormatted = isAmazon 
                                ? `$${(finalPrice / 100).toFixed(2)}` 
                                : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(finalPrice);

                            return (
                                <!-- TỐI ƯU SEO: Đổi thẻ div onclick thành thẻ <a> trỏ link trực tiếp -->
                                <a href={`/san-pham/${p.slug}`} class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary hover:shadow-md transition-all duration-300 flex flex-col h-full group">
                                    <div class="img-square-wrapper">
                                        <img src={imgUrl} loading="lazy" alt={p.name} />
                                    </div>
                                    <div class="p-2 sm:p-3 flex flex-col flex-grow">
                                        <h4 class="text-xs sm:text-sm text-gray-800 font-medium product-title-clamp mb-1.5 group-hover:text-primary">{p.name}</h4>
                                        <div class="mt-auto flex items-center justify-between pt-1.5 border-t border-gray-50">
                                            <span class="text-primary font-bold text-sm sm:text-base">{priceFormatted}</span>
                                            <div class="bg-red-50 text-red-500 text-[9px] px-1 rounded font-bold border border-red-100">MỚI</div>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                    
                    <div class="mt-3 text-right">
                        <!-- Tương tự, dùng thẻ <a> để SEO bot đọc được danh mục -->
                        <a href={`/danh-muc/${category}`} class="text-primary text-[12px] font-bold hover:text-red-700 transition-colors">
                            Xem tất cả ({items.length} sản phẩm) <i class="fa-solid fa-angle-right ml-0.5"></i>
                        </a>
                    </div>
                </div>
            ))}
        </main>

        <!-- Sidebar SEO (Cột bên phải) -->
        <aside class="w-full lg:w-1/4 mt-2 lg:mt-0">
            <div class="sticky-sidebar bg-white p-4 sm:p-5 rounded-xl shadow-sm border border-gray-100">
                <div class="flex items-center gap-2 border-b-2 border-primary pb-2 mb-3">
                    <i class="fa-solid fa-newspaper text-primary text-lg"></i>
                    <h3 class="text-sm sm:text-base font-bold text-gray-800 uppercase tracking-wide">Góc Tư Vấn</h3>
                </div>
                <div class="flex flex-col gap-2 text-sm text-gray-500 text-center py-4">
                    <p>Cập nhật góc review trong bước sau.</p>
                </div>
            </div>
        </aside>

    </div>
</MainLayout>