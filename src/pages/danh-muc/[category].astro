---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase.js';

// 1. TÌM TẤT CẢ CÁC DANH MỤC HIỆN CÓ ĐỂ TẠO TRANG TĨNH
export async function getStaticPaths() {
    const { data: products, error } = await supabase
        .from('vpp_catalog')
        .select('slug, name, price, images, platform, category')
        .in('platform', ['Shopee', 'Shopee VN', 'Lazada'])
        .order('created_at', { ascending: false });

    if (error || !products) return [];

    // Lọc ra danh sách các danh mục không trùng lặp
    const categories = [...new Set(products.map(p => p.category ? p.category.trim() : 'Sản Phẩm Khác'))];

    // Tạo đường dẫn cho từng danh mục và truyền toàn bộ dữ liệu vào để xử lý
    return categories.map((cat) => ({
        params: { category: cat },
        props: { categoryName: cat, allProducts: products },
    }));
}

// 2. NHẬN DỮ LIỆU VÀ LỌC SẢN PHẨM THEO ĐÚNG DANH MỤC
const { categoryName, allProducts } = Astro.props;

const categoryProducts = allProducts.filter(p => {
    const cat = p.category ? p.category.trim() : 'Sản Phẩm Khác';
    return cat === categoryName;
});
---

<MainLayout 
    title={`${categoryName} | VPP TỊNH - Văn Phòng Phẩm & Đồ Thờ Cúng`}
    description={`Khám phá danh sách ${categoryName} chất lượng cao, giá sỉ tốt nhất thị trường tại VPP TỊNH.`}
>
    <!-- Nút quay lại -->
    <a href="/" class="mb-3 inline-flex items-center text-gray-500 hover:text-primary transition font-medium text-xs sm:text-sm">
        <i class="fa-solid fa-arrow-left mr-1.5"></i> Quay lại trang chủ
    </a>

    <div class="bg-white rounded-xl shadow-sm p-3 sm:p-5 border border-gray-100">
        <h1 class="text-lg sm:text-xl font-bold text-gray-900 mb-4 pb-2 border-b-2 border-primary uppercase">{categoryName}</h1>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4">
            {categoryProducts.map((p) => {
                let imgUrl = p.images?.[0] || 'https://via.placeholder.com/300';
                const isAmazon = p.platform?.includes('Amazon');
                
                let finalPrice = p.price || 0;
                if (!isAmazon && finalPrice > 0 && finalPrice < 1000) {
                    finalPrice = finalPrice * 1000;
                }
                const priceFormatted = isAmazon 
                    ? `$${(finalPrice / 100).toFixed(2)}` 
                    : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(finalPrice);

                return (
                    <a href={`/san-pham/${p.slug}`} class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary hover:shadow-md cursor-pointer product-card flex flex-col h-full group transition-all duration-300">
                        <div class="img-square-wrapper">
                            <img src={imgUrl} loading="lazy" alt={p.name} />
                        </div>
                        <div class="p-2 sm:p-3 flex flex-col flex-grow">
                            <h4 class="text-xs sm:text-sm text-gray-800 font-medium product-title-clamp mb-1.5 group-hover:text-primary">{p.name}</h4>
                            <div class="mt-auto pt-1.5 border-t border-gray-50">
                                <span class="text-primary font-bold text-sm sm:text-base">{priceFormatted}</span>
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>
    </div>
</MainLayout>