---
import LayoutEn from '../../../layouts/LayoutEn.astro';
import { supabase } from '../../../lib/supabase.js';

// 1. HÀM TẠO ĐƯỜNG DẪN TĨNH CHO TỪNG DANH MỤC (Thị trường Quốc tế)
export async function getStaticPaths() {
    const { data: products, error } = await supabase
        .from('vpp_catalog')
        .select('name, slug, price, images, platform, category')
        .ilike('platform', '%Amazon%')
        .order('created_at', { ascending: false });

    if (error || !products) return [];

    const groupedProducts = {};
    products.forEach(p => {
        const rawCat = p.category;
        const mainCat = rawCat ? rawCat.trim() : 'Featured Products';
        if (!groupedProducts[mainCat]) groupedProducts[mainCat] = [];
        
        const finalPrice = p.price || 0;
        
        groupedProducts[mainCat].push({
            ...p,
            priceFormatted: `$${(finalPrice / 100).toFixed(2)}`,
            imgUrl: (p.images && p.images.length > 0) ? p.images[0] : 'https://via.placeholder.com/300'
        });
    });

    // Trả về danh sách URL (ví dụ: /en/category/home-living)
    return Object.entries(groupedProducts).map(([categoryName, items]) => {
        const categorySlug = categoryName.toLowerCase().replace(/ /g, '-');
        return {
            params: { category: categorySlug },
            props: { categoryName, items },
        };
    });
}

// 2. NHẬN DỮ LIỆU ĐÃ PHÂN LOẠI VÀ RENDER HTML
const { categoryName, items } = Astro.props;
---

<LayoutEn title={`${categoryName.toUpperCase()} | VPP TINH`}>
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 flex-grow w-full">
        <a href="/en" class="mb-4 inline-flex items-center text-gray-500 hover:text-primary transition font-medium text-sm">
            <i class="fa-solid fa-arrow-left mr-1.5"></i> Back to Store
        </a>
        
        <div class="bg-white rounded-xl shadow-sm p-4 sm:p-6 border border-gray-100">
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-primary uppercase">
                <i class="fa-solid fa-layer-group text-primary mr-2"></i> {categoryName}
            </h1>
            
            <!-- Lưới hiển thị toàn bộ sản phẩm -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-5">
                {items.map((p) => (
                    <a href={`/en/${p.slug}`} class="bg-white rounded-lg border border-gray-100 overflow-hidden hover:border-primary hover:shadow-md transition-all duration-300 cursor-pointer product-card flex flex-col h-full block">
                        <div class="img-square-wrapper">
                            <img src={p.imgUrl} loading="lazy" alt={p.name} />
                        </div>
                        <div class="p-2 sm:p-3 flex flex-col flex-grow">
                            <h4 class="text-xs sm:text-sm text-gray-800 font-medium product-title-clamp mb-1.5">{p.name}</h4>
                            <div class="mt-auto pt-1.5 border-t border-gray-50 flex justify-between items-center">
                                <span class="text-amazon font-bold text-sm sm:text-base">{p.priceFormatted}</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </div>
</LayoutEn>